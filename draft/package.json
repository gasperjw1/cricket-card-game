{
  "name": "@swipe-sixer/draft",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "World Cup Draft — web client over the wcdraft data and engine.",
  "scripts": {
    "sync:data": "node scripts/sync-data.mjs",
    "predev": "node scripts/sync-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-data.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vite": "^8.0.11"
  }
}
